{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  "//": "subgraph/src is AssemblyScript for The Graph, not Node TS — built by `graph build`, not tsc.",
  "include": ["agents", "services", "test", "chain", "flow", "scripts"]
}
