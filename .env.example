# Rook environment — copy to .env for local runs. Fork/test values only.

# --- Local chain (P1: off-chain agents connect here over RPC) ---
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337

# Deployer / demo signer. Use Anvil account #0 (well-known public test key,
# fork/test funds only — real key management is out of scope, ARCHITECTURE.md §7).
DEPLOYER_PRIVATE_KEY=

# --- Risk-Scoring advisory LLM (P1.6) ---
# One bounded Gemini call, advisory only, clamped to +/-10, never authorizing
# (CLAUDE.md §3.4). Unset key -> deterministic rules only (ARCHITECTURE.md §8).
# Free-tier key: https://aistudio.google.com/apikey (no billing required, rate
# limits apply — see ai.google.dev/pricing for current free-tier limits/models).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Set to "off" to force the deterministic keyword fallback (the `npm test`
# script sets this so the unit suite never makes network calls).
ROOK_RISK_LLM=

# --- The Graph (P1.8) ---
SUBGRAPH_URL=http://localhost:8000/subgraphs/name/rook/rook-protocol

# --- Bazantic Gateway (P1.9) ---
BAZANTIC_GATEWAY_PORT=3000
